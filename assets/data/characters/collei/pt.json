  "passiveTalents": [
    {
      "name": "Retorno Floral",
      "unlock": "Desbloqueado na Ascenção 1",
      "description": "Se antes do Bumerangue Floral retornar um dos membros da equipe desencadear a reação elemental de Queimaduras, Aceleração, Intensificação, Propagação, Florescimento, Superflorescimento ou Germinação, concederá ao personagem o estado“Brotar\", que infligirá Dano Dendro continuamente contra os inimigos próximos equivalente a 40% do ATQ de Collei por 3s. Desencadear um novo efeito \"Brotar\" na duração do efeito“Brotar”existente anulará o efeito original. O Dano infligido pelo efeito“Brotar”é considerado Dano de Habilidade Elemental.",
      "level": 1
    },
    {
      "name": "Quietude da Floresta",
      "unlock": "Desbloqueado na Ascenção 4",
      "description": "Quando um personagem dentro da Zona Collambei desencadeia uma reação elemental de Queimaduras, Aceleração, Intensificação, Propagação, Florescimento, Superflorescimento ou Germinação, a duração da área será prolongada em 1s.\nÉ possível prolongar a duração até 3 vezes desta maneira em um uso de Segredo Miauvilhoso.",
      "level": 4
    },
    {
      "name": "Campeã Voadora de Sumeru",
