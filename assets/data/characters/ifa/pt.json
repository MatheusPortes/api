  "passiveTalents": [
    {
      "name": "Acordo de Resgate Mútuo",
      "unlock": "Desbloqueado na Ascenção 1",
      "description": "Quando o membro próximo da equipe desencadeia a Explosão do Espírito da Noite, aumenta a Proficiência Elemental de Ifa em 80 pontos por 10s.",
      "level": 1
    },
    {
      "name": "Presente do Reino da Noite: Resgate de Emergência Focado",
      "unlock": "Desbloqueado na Ascenção 4",
      "description": "Depois que os pontos de Espírito da Noite de Ifa acabarem, ele mudará para consumir Flogisto para manter a Bênção do Espírito da Noite.\nEnquanto estiver numa área de Natlan com Dispositivos de Flogisto, ele pode usar Transmissão do Espírito da Noite: Ifa. Quando o personagem estiver em uma certa altura no ar, trocar para Ifa como personagem ativo desencadeará: Ifa entra no estado Bênção do Espírito da Noite e obtém 32 pontos de Espírito da Noite. Sua própria equipe pode entrar em Transmissão do Espírito da Noite uma vez a cada 10s.",
      "level": 4
    },
    {
      "name": "Compressa Quente Tática",
      "unlock": "Desbloqueado automaticamente",
      "description": "Quando está em uma área de Natlan com Dispositivo de Flogisto, quando o personagem ativo da equipe ou um Sauriano habitado possui menos de 40% de Vida, Ifa consome 10 de Flogisto para regenerar 40% Vida para ele. Esse efeito pode ser desencadeado uma vez a cada 10s, e não surte em domínios, Domínios Dizimados e Abismo do Espiral."
    }
  ],
